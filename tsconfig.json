{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": false,
    "allowJs": true,
    "checkJs": false,
    "jsx": "react-native",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleResolution": "bundler",
    "target": "esnext",
    "lib": ["esnext", "dom"]
  },
  "include": ["**/*.ts", "**/*.tsx", "App.tsx", "index.ts"],
  "exclude": ["node_modules", "android", "ios", "build", ".expo", "dist"]
}
